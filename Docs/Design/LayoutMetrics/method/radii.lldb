# Every visible view with a corner radius: layer.cornerRadius and the iOS 26+ effective radius
# (UICornerConfiguration), in window coordinates. Run: xcrun lldb --batch -p <app pid> -s radii.lldb
expr -l swift -O -- import UIKit; let __w = UIApplication.shared.connectedScenes.compactMap { ($0 as? UIWindowScene)?.keyWindow }.first!; func __vcs(_ vc: UIViewController) -> [UIViewController] { [vc] + vc.children.flatMap { __vcs($0) } + (vc.presentedViewController.map { __vcs($0) } ?? []) }; let __tbc = __vcs(__w.rootViewController!).compactMap { $0 as? UITabBarController }.first; func __views(_ v: UIView) -> [UIView] { [v] + v.subviews.flatMap { __views($0) } }; __views(__w).filter { !$0.isHidden && $0.alpha > 0.01 && ($0.layer.cornerRadius > 0 || $0.effectiveRadius(corner: .topLeft) > 0 || $0.effectiveRadius(corner: .bottomLeft) > 0) }.map { v in let r = v.convert(v.bounds, to: __w); return "\(String(describing: type(of: v)).prefix(60)) abs=(\(r.origin.x) \(r.origin.y); \(r.width) \(r.height)) layer=\(v.layer.cornerRadius) eff=\(v.effectiveRadius(corner: .topLeft))/\(v.effectiveRadius(corner: .bottomLeft))" }.joined(separator: "\n")
detach
