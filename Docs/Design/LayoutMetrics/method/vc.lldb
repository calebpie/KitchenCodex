# Each view controller's view in window coordinates: safe-area insets, directional layout margins,
# system minimum margins and readable-content guide. Run: xcrun lldb --batch -p <app pid> -s vc.lldb
expr -l swift -O -- import UIKit; let __w = UIApplication.shared.connectedScenes.compactMap { ($0 as? UIWindowScene)?.keyWindow }.first!; func __vcs(_ vc: UIViewController) -> [UIViewController] { [vc] + vc.children.flatMap { __vcs($0) } + (vc.presentedViewController.map { __vcs($0) } ?? []) }; let __tbc = __vcs(__w.rootViewController!).compactMap { $0 as? UITabBarController }.first; func __views(_ v: UIView) -> [UIView] { [v] + v.subviews.flatMap { __views($0) } }; __vcs(__w.rootViewController!).filter { $0.isViewLoaded && $0.view.window != nil }.map { vc in let v = vc.view!; let r = v.convert(v.bounds, to: __w); let m = v.directionalLayoutMargins; return "\(String(describing: type(of: vc)).prefix(70)) abs=(\(r.origin.x) \(r.origin.y); \(r.width) \(r.height)) safe=(t \(v.safeAreaInsets.top) l \(v.safeAreaInsets.left) b \(v.safeAreaInsets.bottom) r \(v.safeAreaInsets.right)) margins=(t \(m.top) l \(m.leading) b \(m.bottom) r \(m.trailing)) sysMin=(l \(vc.systemMinimumLayoutMargins.leading) r \(vc.systemMinimumLayoutMargins.trailing)) readable=\(v.readableContentGuide.layoutFrame.minX)-\(v.readableContentGuide.layoutFrame.maxX)" }.joined(separator: "\n")
detach
