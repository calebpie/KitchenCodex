# Every UIView in the key window, in window coordinates (points), with label text and font size,
# corner radii, scroll offsets and insets; then the window's safe area, status bar frame, scale,
# orientation, size classes and appearance. Run: xcrun lldb --batch -p <app pid> -s frames.lldb
expr -l swift -O -- import UIKit; func __walk(_ v: UIView, _ depth: Int, _ w: UIWindow) -> String { let r = v.convert(v.bounds, to: w); var extra = ""; if let l = v as? UILabel { extra += " text='\(l.text ?? "")' font=\(l.font.pointSize)" }; if v.layer.cornerRadius > 0 { extra += " radius=\(v.layer.cornerRadius)" }; let __eTL = v.effectiveRadius(corner: .topLeft), __eBL = v.effectiveRadius(corner: .bottomLeft); if __eTL > 0 || __eBL > 0 { extra += " effRadius=\(__eTL)/\(__eBL)" }; if v.isHidden || v.alpha < 0.01 { extra += " [invisible]" }; if let sv = v as? UIScrollView { extra += " offset=\(sv.contentOffset) inset=\(sv.adjustedContentInset)" }; var s = String(repeating: " ", count: depth) + "\(type(of: v)) abs=(\(r.origin.x) \(r.origin.y); \(r.width) \(r.height))" + extra + "\n"; for c in v.subviews { s += __walk(c, depth + 1, w) }; return s }; let __w = UIApplication.shared.connectedScenes.compactMap { ($0 as? UIWindowScene)?.keyWindow }.first!; __walk(__w, 0, __w) + "\nSAFEAREA \(__w.safeAreaInsets)\nSTATUSBAR \(String(describing: __w.windowScene?.statusBarManager?.statusBarFrame))\n" + ("SCALE \(__w.screen.scale) BOUNDS \(__w.bounds) ORIENT \(__w.windowScene!.effectiveGeometry.interfaceOrientation.rawValue) SIZECLASS h=\(__w.traitCollection.horizontalSizeClass.rawValue) v=\(__w.traitCollection.verticalSizeClass.rawValue) STYLE \(__w.traitCollection.userInterfaceStyle.rawValue)")
detach
